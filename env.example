# Copy this file to .env and fill in the keys.

# Meta Model API key from https://dev.meta.ai (needed for the Muse Spark report and SAM 3.1 outlines)
MODEL_API_KEY=

# Optional: NASA FIRMS map key for active fires, free at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Optional overrides
# META_CHAT_MODEL=muse-spark-1.3
# META_SAM_MODEL=sam-3.1
